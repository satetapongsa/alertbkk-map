# =====================================================================
# OSINTRIS Environment Configuration
# Real-Time Public Safety Intelligence Platform
# =====================================================================

# PostGIS PostgreSQL Database Connection
DATABASE_URL=postgresql://osintris_admin:password@localhost:5432/osintris_db?schema=public

# High-Performance In-Memory Cache & Pub/Sub
REDIS_URL=redis://localhost:6379

# Geospatial Tile Providers
MAP_PROVIDER=esri_world_imagery
MAP_API_KEY=

# YouTube Public API (For verifying public livestreams)
YOUTUBE_API_KEY=

# Meteorological Open Data Feeds
WEATHER_API_KEY=

# Reverse Geocoding Services
GEOCODING_API_KEY=

# Social Media & OSINT Open Feeds
SOCIAL_API_KEY=
OSINT_API_KEY=

# Application Mode (Set to true to run in simulated live mode if backend offline)
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_WS_URL=ws://localhost:3001
